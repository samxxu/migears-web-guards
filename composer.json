{
    "name": "migears/web-guards",
    "description": "miGears Web Guards - before() guards for migears/web: auth, authorization, CSRF, IP filter, signature, throttling, maintenance, kill switch, user-agent, HTTPS, canonical, request checks, CORS and time window",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "keywords": [
        "guard",
        "middleware",
        "rest",
        "api",
        "migears",
        "rate-limit",
        "throttle",
        "authentication",
        "authorization",
        "acl",
        "csrf",
        "cors",
        "ip-filter",
        "signature",
        "maintenance-mode",
        "kill-switch",
        "user-agent",
        "https",
        "redirect",
        "time-window",
        "response-401",
        "response-403",
        "response-429",
        "response-503"
    ],
    "homepage": "https://github.com/samxxu/migears-web-guards",
    "authors": [
        {
            "name": "Sam X. Xu",
            "email": "samxxu@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/samxxu/migears-web-guards/issues",
        "source": "https://github.com/samxxu/migears-web-guards"
    },
    "require": {
        "php": "^8.1",
        "migears/web": "^2.0",
        "migears/data-structure": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "MiGears\\WebGuards\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\WebGuards\\Tests\\": "tests/"
        }
    },
    "repositories": {
        "migears/web": {
            "type": "path",
            "url": "../migears-web"
        },
        "migears/data-structure": {
            "type": "path",
            "url": "../migears-data-structure"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
